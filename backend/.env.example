# Copy to backend/.env for local runs. On a host (e.g. Vercel), set the same names in the
# project's environment variable settings instead. Never commit real values.

# Required for real AI (Bedrock chat, summary, documents; Polly voice). The IAM user may
# only call bedrock:InvokeModel and polly:SynthesizeSpeech. Without them the app still
# runs on its fixed fallback text.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional. Defaults to Claude Haiku 4.5 (US inference profile).
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Sites allowed to call this API, comma-separated, no trailing slash.
# Unset means the local dev server (http://localhost:5173).
# FRONTEND_ORIGINS=https://your-frontend.vercel.app

# Optional voice. Without these, spoken text uses Amazon Polly.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=
